{
  "name": "dsh-tencent-docs",
  "version": "0.3.4",
  "type": "module",
  "description": "Tencent Docs in the DSH sidebar: recent files, folder tree and search over the official Tencent Docs MCP endpoint, plus a local link list.",
  "license": "MIT",
  "author": "liuxc",
  "homepage": "https://github.com/liuxc/dsh-tencent-docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxc/dsh-tencent-docs.git"
  },
  "bugs": {
    "url": "https://github.com/liuxc/dsh-tencent-docs/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tencent-docs",
    "docs",
    "mcp",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "market"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale"]
    }
  }
}
